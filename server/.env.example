# 后端服务端口
PORT=4000

# JWT 签名密钥（生产环境务必改成一段足够长的随机字符串，并妥善保管）
JWT_SECRET=please-change-me-to-a-long-random-string

# JWT 有效期（例如 7d = 7 天、1h = 1 小时）
JWT_EXPIRES_IN=7d

# 允许跨域访问的前端地址（生产环境改为 Vercel/Zeabur 前端域名）
CORS_ORIGIN=http://localhost:3000

# PostgreSQL 连接串（Supabase：Settings → Database → Connection string）
# 形如：postgresql://postgres.xxxx:password@aws-0-xxxx.pooler.supabase.com:5432/postgres
# 不设置则使用内存存储（仅本地开发，重启数据即失）
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# 是否使用 SSL 连接数据库（Supabase 等托管库需 true；本地裸连可设 false）
DB_SSL=true
